<?xml version="1.0" encoding="UTF-8"?>
<!--
Xcode Default (Light)
Hand-authored for diff-reckoner from the colors of Apple's built-in Xcode "Xcode Default (Light)"
source-editor theme (sRGB values, as Xcode 15 paints them), mapped onto TextMate scopes.
Xcode colors some roles from semantic analysis (project vs system symbols) that regex
grammars cannot see; those roles map to the nearest scope.
Licence: MIT (diff-reckoner). The color values are Apple's.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Xcode Default (Light)</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#FFFFFF</string>
				<key>foreground</key>
				<string>#262626</string>
				<key>caret</key>
				<string>#000000</string>
				<key>lineHighlight</key>
				<string>#E8F2FF</string>
				<key>selection</key>
				<string>#A4CDFF</string>
				<key>gutterForeground</key>
				<string>#A6A6A6</string>
				<key>diffDeleted</key>
				<string>#EEEEF0</string>
